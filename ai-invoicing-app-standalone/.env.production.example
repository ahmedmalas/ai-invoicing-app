NODE_ENV=production
DATABASE_URL=postgresql://user:password@pooled-host.example.com:5432/database?sslmode=require
DB_POOL_MAX=5
LOG_LEVEL=info
SERVICE_NAME=ai-business-os
ENABLE_STRUCTURED_LOGGING=1
ORGANIZATION_ID=single-tenant
CORS_ORIGIN=https://ai-invoicing-app.vercel.app
PUBLIC_APP_URL=https://ai-invoicing-app.vercel.app
REQUEST_BODY_LIMIT=1048576
ENABLE_BROWSER_APP=1
SUPABASE_URL=https://jsrxhisdjvwsufbqqtir.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Aleya AI — Vercel AI Gateway (server-side only; never NEXT_PUBLIC_*)
# On Vercel production, OIDC is preferred (no static key required when AI Gateway is enabled).
# AI_GATEWAY_API_KEY=
# ALEYA_AI_MODEL=openai/gpt-5.4
# ALEYA_AI_MAX_STEPS=48
# ALEYA_AI_ALLOW_DETERMINISTIC_PLAN=0

# Basiq bank feeds (server-only)
# BASIQ_API_KEY=
